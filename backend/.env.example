# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=flowcraft_plumbing
DB_USER=flowcraft
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Set to True to use SQLite instead of Postgres (quick local dev)
USE_SQLITE=False

# CORS / Frontend
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (SMTP). Leave EMAIL_BACKEND as console backend for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FlowCraft Plumbing <no-reply@flowcraftplumbing.com>
COMPANY_NOTIFICATION_EMAIL=bookings@flowcraftplumbing.com
SEND_CUSTOMER_CONFIRMATION_EMAIL=True
